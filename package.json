{
  "name": "sultana-whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp AI sales assistant for Sultana Food Industry, powered by Google Gemini (free tier)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch scripts/dev-server.ts",
    "chat": "node --env-file-if-exists=.env --import tsx scripts/chat.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "linked": "node --env-file-if-exists=.env --import tsx scripts/linked-device.ts",
    "start": "node --import tsx scripts/linked-device.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.10.2",
    "baileys": "^7.0.0-rc14",
    "pino": "^9.14.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.9.0"
  }
}
