# --- Google Gemini, free tier (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional: pin a model instead of Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you make up; paste the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Used to check that webhooks really come from Meta.
WHATSAPP_APP_SECRET=

# --- Your own WhatsApp number: receives new-order and "needs a person" alerts ---
# Country code + number, digits only.
OWNER_WHATSAPP_NUMBER=60123456789
HANDOFF_HOURS=12
HISTORY_LIMIT=30

# --- Memory (recommended in production): Upstash Redis, or Vercel's Redis/KV integration ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
